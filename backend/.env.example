# ============================================================================
# Backend (FastAPI) — Environment Variables
# Set these in the Render dashboard OR in a local backend/.env file.
# Copy this file to backend/.env and fill in values for local development.
# ============================================================================

# ── CORS: Allowed Frontend Origins ─────────────────────────────────────────
# Comma-separated list of origins that may call the API.
# Local Vite dev origins (localhost:5173 etc.) are always allowed automatically.
#
# Local development: leave blank (localhost origins are always allowed).
# Production (Render): set to your Vercel frontend URL, e.g.:
#   FRONTEND_ORIGIN=https://your-agri-frontend.vercel.app
# Multiple origins (staging + production):
#   FRONTEND_ORIGIN=https://staging.vercel.app,https://prod.vercel.app
FRONTEND_ORIGIN=

# ── Port (Render sets this automatically; local can override) ──────────────
# PORT=8000

# ── External Model Storage (Backblaze B2) ──────────────────────────────────
# Backblaze B2 S3-compatible storage configuration for model artifacts.
# Required for Render deployment. Leave empty for local development with local models.
#
# Backblaze B2 S3 endpoint URL (region-specific):
#   Example: https://s3.us-west-002.backblazeb2.com
B2_ENDPOINT_URL=

# B2 Application Key ID (20 characters)
B2_ACCESS_KEY_ID=

# B2 Application Key (40 characters)
B2_SECRET_ACCESS_KEY=

# B2 bucket name
B2_BUCKET_NAME=

# B2 region (optional, usually included in endpoint)
# Example: us-west-002
B2_REGION=
