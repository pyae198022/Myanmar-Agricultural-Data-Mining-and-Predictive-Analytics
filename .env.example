# ============================================================================
# Frontend (Vite) — Environment Variables
# Set these in Vercel dashboard OR in a local .env file.
# Copy this file to .env and fill in values for local development.
# ============================================================================

# ── API Backend URL ────────────────────────────────────────────────────────
# Local development: leave blank or set to http://localhost:8000
#   (Blank uses relative /api path which the Vite dev proxy forwards to :8000)
# Production (Vercel): set to your Render backend public URL, e.g.:
#   VITE_API_BASE_URL=https://your-agri-backend.onrender.com
VITE_API_BASE_URL=

# ── External Model Storage (Backend) ───────────────────────────────────────
# Only needed for Render deployment. Not required for local development.
# This tells the backend where to download ML model artifacts from.
# See backend/.env.example for full configuration.
MODEL_STORAGE_BASE_URL=https://your-bucket.r2.cloudflarestorage.com/models
